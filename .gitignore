node_modules/
.next/
.env.local
.env.*.local
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Local Netlify folder
.netlify

# Local Claude Code config (session-specific, not for VCS)
# Contains admin permissions / may embed env values — never deploy.
.claude/

# Claude Code memory / handoff buffers — session-only, never VCS.
.remember/

# Claude Code instruction files — tooling-specific, not part of site repo.
AGENTS.md
CLAUDE.md

# Working documents (briefs, PPTX/DOCX change requests, plans, specs).
# Session-local source material — may embed values from .env.local, and
# is not part of the shipped site. Kept on disk for continuity, never
# committed and never deployed to Netlify.
docs/

# Temporary PPTX/DOCX extraction scratch (unzipped slides + media).
# Regenerated on demand by scripts/extract.js; never shipped. It was
# accidentally committed once (~55 MB, 159 files) and made every push
# slow enough to time out.
.tmp-deck/

# Supabase CLI temp artifacts (version stamps, cached project state)
supabase/.temp/

# SEO audit scratch sheet — working notes, not site content
SEO_PHASE3_TODO.csv

# Local MCP config (URLs only, no secrets — but excluded for safety)
.mcp.json

# Playwright MCP session artifacts (console logs, page snapshots) — ephemeral, regenerated per run
.playwright-mcp/

# TypeScript incremental build cache (regenerated by `tsc`)
*.tsbuildinfo

# Raw source footage — GitHub rejects any file over 100 MB, and a 177 MB
# MP4 in the repo blocks the whole push. Only the web-optimised copies
# (produced by scripts/compress-videos.sh) are committed.
public/videos/*.mp4
!public/videos/*-web.mp4

public/videos/*.mp4
