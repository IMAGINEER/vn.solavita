# Copy to .env.local and fill in real values. NEVER commit .env.local.
NEXT_PUBLIC_BASE_URL=

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX).
# Public by design — it is inlined into the client bundle at build
# time, so it is not a secret. Must be set for BUILD (not just
# runtime) on Netlify, otherwise it is undefined in the shipped JS and
# the gtag loader silently no-ops.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Supabase (form backend — consultation_leads + email_logs)
SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=...

# Resend (confirmation email)
RESEND_API_KEY=...
